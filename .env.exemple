# Copier en `.env` et remplir. Le `.env` n'est pas versionné : il décrit
# CE serveur, pas le projet.

# Le nom sur lequel Traefik routera. C'est l'URL que 418.extension
# interrogera — elle est en dur côté volet, donc ne la changez pas à la
# légère une fois des postes déployés.
DOMAINE=cloud.418.archi

# Le réseau que Traefik écoute déjà. `traefik` chez beaucoup, `proxy` chez
# d'autres : `docker network ls` le dira.
RESEAU=traefik

# Le résolveur de certificats déclaré dans la configuration de Traefik.
CERTRESOLVER=letsencrypt
